<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_payment_form" model="ir.ui.view">
        <field name="name">account.payment.group.customer.pay.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <notebook>
                <page string="Líneas de Transferencia" groups="account.group_account_manager,public_budget.group_habilitacion_director">
                    <group>
                        <group>
                            <field name="fecha_de_acreditacion" readonly="state == 'posted'"/>
                            <field name="grupo_asingado_por_bmr"  readonly="state == 'posted'"/>
                            <field name="tipo_de_pago" readonly="state == 'posted'"/>
                            <field name="sucursal_de_cuenta_debito" readonly="state == 'posted'"/>
                            <field name="numero_de_cuenta_debito" readonly="state == 'posted'"/>
                            <field name="tipo_de_cuenta" readonly="state == 'posted'"/>
                        </group>
                        <group>
                            <field name="importe_total"/>
                            <field name="cantidad"/>
                            <field name="archivo_banco_name" invisible="1"/>
                            <label for="archivo_banco" filename="archivo_banco_name"/>
                            <div>
                                <field name="archivo_banco" filename="archivo_banco_name"/>
                                <button type="object" name="generar_archivo_banco" string="Generar Archivo" class="oe_inline oe_link"/>
                            </div>
                        </group>
                    </group>
                    <button type="action" name="%(sipreco_payment_line.action_account_payment_line_import)d" string="Importar"/>
                    <button type="object" name="check_payment_lines_total" string="Verificar Total"/>
                    <button name="remove_all_transfer_lines" string="Eliminar todo" invisible="sipreco_state != 'draft'" type="object"/>
                    <field name="payment_line_ids" readonly="sipreco_state != 'draft'">
                        <list editable="bottom">
                            <field name="partner_id"/>
                            <field name="cuit"/>
                            <field name="bank_account_id"/>
                            <button type="object" icon="fa-refresh" title="Refresh" name="refresh_bank_account"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
