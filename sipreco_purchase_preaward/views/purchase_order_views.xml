<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_preaward_form_view" model="ir.ui.view">
        <field name="name">purchase.order.preaward.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="preaward" widget="boolean_toggle"
                    column_invisible="not parent.requisition_id"
                    readonly="state in ['cancel', 'purchase', 'done']"/>
            </xpath>
        </field>
    </record>

</odoo>
