<!-- because we generate checks on post, checks report is made from payments -->
    <!-- payments list view -->
    <record model="ir.ui.view" id="view_account_payment_tree">
        <field name="name">account.payment.list</field>
        <field name="model">account.payment</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <list>
                <!-- por ahora usamos metodo distinto para cambio de retenciones y de cheque, pero la idea sería implementar el mismo metodos -->
                <button name="change_withholding" icon="fa-undo" type="object" invisible="payment_type != 'outbound' or state != 'posted' or payment_method_code != 'withholding'" confirm="Seguro que desea devolver esta retención?" title="Change"/>
                <field name="payment_type" column_invisible="True"/>
            </list>

            <!-- reemplazmos campo name por orden de pago -->
            <field name="name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- <field name="name" position="after"> sacamos por depreciacion de payment_group
                <field name="payment_group_id"/>
            </field> -->
            <field name="partner_id" position="after">
                <field name="destination_journal_id"/>
            </field>
        </field>
    </record>

    <!-- tree of payments on payment groups -->
    <record id="view_account_payment_from_group_tree" model="ir.ui.view">
        <field name="name">account.payment.list</field>
        <field name="model">account.payment</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="account_payment_pro.view_account_payment_tree"/>
        <!-- <field name="inherit_id" ref="account_payment.view_account_payment_from_group_tree"/> -->
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-muted">return_payment_id</attribute>
            </list>
            <list>
                <field name="return_payment_id" column_invisible="True"/>
                <!-- por ahora usamos metodo distinto para cambio de retenciones y de cheque, pero la idea sería implementar el mismo metodos -->
                <button name="change_withholding" icon="fa-undo" type="object" invisible="payment_type != 'outbound' or state != 'posted' or payment_method_code != 'withholding'" confirm="Seguro que desea devolver esta retención?" title="Change"/>
                <field name="payment_type" column_invisible="True"/>
            </list>
            <!-- TODO No est mas el boton lo agregamos otr vez?
            <button name="%(l10n_ar_tax.action_report_withholding_certificate)d" position="attributes">
                <attribute name="invisible">1</attribute>
            </button> -->
        </field>
    </record>

</odoo>
