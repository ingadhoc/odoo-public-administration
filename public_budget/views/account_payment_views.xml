<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <field name="date" position="after">
                <field name="assignee_id" groups="!public_budget.group_change_payment_assignee" readonly="state != 'draft'"/>
                <field name="assignee_id" groups="public_budget.group_change_payment_assignee"/><!-- reemplaza vista view_account_payment_edit_assignee_form-->
                <field name="return_payment_id" invisible="not return_payment_id"/>
            </field>
            <field name="date" position="attributes">
                <!-- <attribute name="invisible">1</attribute> -->
                <!-- al final lo hacemos invisible así porque en transferencias lo queremos visible -->
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
        </field>
    </record>

