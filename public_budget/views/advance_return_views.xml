<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_public_budget_advance_return_filter" model="ir.ui.view">
        <field name="name">public_budget.advance_return.select</field>
        <field name="model">public_budget.advance_return</field>
        <field name="arch" type="xml">
            <search string="Advance Return">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="type_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_type_id" string="Type" context="{'group_by':'type_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORMVIEW -->
    <record id="view_public_budget_advance_return_form" model="ir.ui.view">
        <field name="name">public_budget.advance_return.form</field>
        <field name="model">public_budget.advance_return</field>
        <field name="arch" type="xml">
            <form string="Advance Return">
                <header>
                    <button name="action_confirm" invisible="state != 'draft'" string="Confirm" type="object" class="oe_highlight" groups="account.group_account_user"/>
                    <button name="action_cancel_draft" invisible="state != 'cancel'" type="object" string="To Draft"/>
                    <button name="action_cancel" invisible="state not in ('confirmed', 'draft')" string="Cancel" type="object" groups="account.group_account_user"/>
                    <field name="state" widget="statusbar" statusbar_colors='{}'/>
                </header>
                <sheet string="advance_return">
                    <div class="oe_button_box" name="buttons">
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="confirmation_date" invisible="not confirmation_date" readonly="state != 'draft'"/>
                            <field name="move_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <button name="compute_debtors" type="object" string="Fill with Debtors" invisible="state != 'draft'"/>
                    <field name="return_line_ids" readonly="state != 'draft'">
                        <list string="Advance Return Line" editable="top">
                            <field name="employee_id"/>
                            <field name="debt_amount" invisible="state != 'draft'" sum="Total"/>
                            <field name="returned_amount" sum="Total"/>
                            <field name="state" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>

            </form>
        </field>
    </record>

    <!-- TREEVIEW -->
    <record id="view_public_budget_advance_return_tree" model="ir.ui.view">
        <field name="name">public_budget.advance_return.list</field>
        <field name="model">public_budget.advance_return</field>
        <field name="arch" type="xml">
            <list string="Advance Return" decoration-muted="state=='cancelled'" decoration-info="state == 'draft'" decoration-bf="state == 'confirmed' " decoration-danger="state in ()">
                <field name="name" readonly="state != 'draft'"/>
                <field name="type_id" readonly="state != 'draft'"/>
                <field name="date" readonly="state != 'draft'"/>
                <field name="user_id" readonly="state != 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                <field name="state"/>
            </list>
        </field>
    </record>

</odoo>
