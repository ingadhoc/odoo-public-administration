<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_public_budget_transaction_filter" model="ir.ui.view">
        <field name="name">public_budget.transaction.select</field>
        <field name="model">public_budget.transaction</field>
        <field name="arch" type="xml">
            <search string="Budget Transaction">
                <field name="issue_date"/>
                <field name="budget_id"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="expedient_id"/>
                <field name="type_id"/>
                <field name="supplier_ids"/>
                <field name="budget_position_ids" filter_domain="['|', ('budget_position_ids', 'ilike', self), ('advance_preventive_line_ids', 'ilike', self)]"/>
                <filter name="with_advance_payment" string="With Advance Payment" domain="[('type_id.with_advance_payment','ilike',True)]"/>
                <group expand="0" string="Group By">
                    <field name="supplier_ids" string="Suppliers" context="{'group_by':'supplier_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORMVIEW -->
    <record id="view_public_budget_transaction_form" model="ir.ui.view">
        <field name="name">public_budget.transaction.form</field>
        <field name="model">public_budget.transaction</field>
        <field name="arch" type="xml">
            <form string="Budget Transaction">
                <header>
                    <button name="%(action_aeroo_report_transaction)d" class="oe_highlight" string="Print" type="action"/>
                    <button name="action_cancel_draft" type="object" invisible="state != 'cancel'" string="To Draft"/>
                    <button name="action_open" type="object" invisible="state != 'draft'" string="Open" class="oe_highlight"/>
                    <button name="action_close" type="object" invisible="state != 'open'" string="Close" class="oe_highlight"/>
                    <button name="action_cancel" type="object" invisible="state not in ('closed', 'draft', 'open')" string="Cancel" groups="account.group_account_user"/>
                    <field name="state" widget="statusbar" statusbar_colors='{}'/>
                </header>
                <sheet string="Budget Transaction">
                    <div class="oe_button_box" name="buttons">
                        <field name="asset_ids" invisible="1"/>
                        <button type="object" name="action_view_account_asset" class="oe_stat_button" string="Assets" icon="fa-list-alt" invisible="not asset_ids"/>
                    </div>
                    <field name="id" invisible="True"/>
                    <field name="user_location_ids" invisible="True"/>
                    <field name="type_with_advance_payment" invisible="1"/>
                    <!-- si no lo agregamos aca no refresca en voucher, raro... -->
                    <field name="supplier_ids" invisible="1"/>
                    <field name="definitive_partner_type" invisible="1"/>
                    <group>
                        <group>
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="budget_id" readonly="state != 'draft'"/>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="expedient_id" domain="[('current_location_id', 'in', user_location_ids),('in_transit','=',False),('state','=','open')]" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="partner_id" invisible="not type_with_advance_payment" required="type_with_advance_payment" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                        </group>
                        <!-- <group col="1"> -->
                        <!-- asi quedó en 3 columnas y gustó mas -->
                        <group>
                            <group name="amounts">
                                <label for="preventive_amount"/>
                                <div>
                                    <field name="preventive_amount" class="oe_inline"/>
 /
                                    <field name="preventive_balance" class="oe_inline"/>
                                </div>
                                <label for="definitive_amount"/>
                                <div>
                                    <field name="definitive_amount" class="oe_inline"/>
 /
                                    <field name="definitive_balance" class="oe_inline"/>
                                </div>
                                <label for="invoiced_amount"/>
                                <div>
                                    <field name="invoiced_amount" class="oe_inline"/>
 /
                                    <field name="invoiced_balance" class="oe_inline"/>
                                </div>
                                <label for="to_pay_amount"/>
                                <div>
                                    <field name="to_pay_amount" class="oe_inline"/>
 /
                                    <field name="to_pay_balance" class="oe_inline"/>
                                </div>
                                <field name="paid_amount"/>
                            </group>
                            <group invisible="not type_with_advance_payment" name="advance_amounts">
                                <field name="advance_preventive_amount"/>
                                <field name="advance_to_pay_amount"/>
                                <field name="advance_paid_amount"/>
                                <field name="advance_remaining_amount"/>
                                <field name="advance_to_return_amount"/>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Affectations">
                            <!-- because it wont update till we save it we add definitive partner_type in context -->
                            <label for="advance_preventive_line_ids" string="Advance Lines" invisible="not type_with_advance_payment"/>
                            <field name="advance_preventive_line_ids" invisible="not type_with_advance_payment" context="{'default_definitive_partner_type': definitive_partner_type, 'default_advance_line': 1, 'default_preventive_status': 'confirmed', 'advance_line': 1}" readonly="state != 'open'"/>
                            <label for="preventive_line_ids" string="Settlement Lines" invisible="not type_with_advance_payment"/>
                            <!-- send transaction to force onchange -->
                            <field name="preventive_line_ids" context="{'default_transaction_id': id, 'default_definitive_partner_type': definitive_partner_type,}" readonly="state != 'open'"/>
                        </page>
                        <page string="Payment Orders and Refunds" invisible="not type_with_advance_payment">
                            <button class="oe_link" string="Create Payment Order" invisible="state != 'open'" type="object" name="action_new_payment"/>
                            <field name="advance_payment_ids" context="{'default_transaction_id':id, 'default_partner_id': partner_id, 'default_partner_type': 'supplier', 'list_view_ref': 'account.view_account_supplier_payment_tree'}" readonly="state == 'open'"/>
                        </page>
                        <page string="Invoices">
                            <div>
                                <button class="oe_link" string="Create Invoice" invisible="state != 'open'" type="action" name="%(public_budget.action_definitive_make_invoice)d"/>
                                    or
                                <button class="oe_link" string="Mass Invoice Create" invisible="state != 'open'" type="action" name="%(public_budget.action_definitive_mass_invoice_create)d"/>
                            </div>
                            <field name="invoice_ids" nolabel="1" readonly="state != 'open'"/>
                        </page>
                        <page string="Payment Orders" invisible="type_with_advance_payment">
                            <button class="oe_link" string="Create Payment Order" invisible="state != 'open'" type="object" name="action_new_payment"/>
                                or
                            <button class="oe_link" string="Mass Payment Order Create" invisible="state != 'open'" type="object" name="mass_payment_group_create" confirm="Se van a generar ordenes de pago para todos los comprobantes que no se encuentren en ordenes de pago, seguro que quiere continuar?"/>
                            <field name="payment_ids" context="{'default_partner_type': 'supplier', 'default_transaction_id':id, 'list_view_ref': 'account.view_account_supplier_payment_tree'}" readonly="state != 'open'"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- TREEVIEW -->
    <record id="view_public_budget_transaction_tree" model="ir.ui.view">
        <field name="name">public_budget.transaction.list</field>
        <field name="model">public_budget.transaction</field>
        <field name="arch" type="xml">
            <list string="Budget Transaction" decoration-muted="state=='cancelled'" decoration-info="state == 'draft'" decoration-bf="state in ['open', 'closed']" decoration-danger="state in ()">
                <field name="issue_date" readonly="state != 'draft'"/>
                <field name="budget_id" readonly="state != 'draft'"/>
                <field name="name" readonly="state != 'draft'"/>
                <field name="user_id"/>
                <field name="expedient_id" readonly="state != 'draft'"/>
                <field name="type_id" readonly="state != 'draft'"/>
                <field name="state"/>
            </list>
        </field>
    </record>

</odoo>
