<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_account_payment_search">
        <field name="name">account.payment.filter</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <filter name='state_draft' position="after">
                <filter string="En Proceso de Firma"
                    domain="[('approval_state','=','signature_process')]"
                    name='state_signature_process' />
                <filter string="Firmado" domain="[('approval_state','=','signed')]"
                    name='state_signed' />
            </filter>
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', '|',
                    ('reference','ilike',self), ('name', 'ilike', self), ('partner_id', 'ilike',
                    self), ('memo', 'ilike', self), ('amount_company_currency_signed' , 'ilike',
                    self), ('amount', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field name="transaction_id" />
                <field name="budget_id" />
                <field name="expedient_id" />
                <field name="budget_position_ids" />
            </field>
            <filter name="state" position="after">
                <filter name="fecha_pago" string="Fecha Min. de Pago" domain="[]"
                    context="{'group_by': 'payment_min_date'}" />
            </filter>
            <filter name="state" position="attributes">
                <attribute name="context">{'group_by': 'sipreco_state'}</attribute>
            </filter>
        </field>
    </record>

    <!-- list view modification -->
    <record id="view_account_supplier_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.pay.list</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree" />
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="replace">
                <field name="sipreco_state" widget="badge"
                    decoration-info="sipreco_state == 'draft'"
                    decoration-warning="sipreco_state in ['signature_process','signed']"
                    decoration-success="sipreco_state == 'in_process'" />
            </xpath>


            <!-- para que solo se puedan crear con el botón -->
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
            <field name="date" position="after">
                <field name="payment_min_date" />
            </field>
            <field name="payment_method_line_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="date" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <!-- para poder ver lo que se manda a pagar antes de que se carguen los pagos -->
            <field name="payment_total" position="before">
                <field name="to_pay_amount" sum="Total" />
            </field>
            <field name="partner_id" position="before">
                <field name="reference" />
            </field>
            <list position="inside">
                <button name="confirm" type="object" string="Confirm"
                    invisible="sipreco_state != 'draft' or (not transaction_id and not advance_request_id)"
                    icon="fa-arrow-circle-right" groups="account.group_account_manager" />
            </list>
            <!-- ocultamos cosas que no usan para que no molesten en la vista -->
            <!-- <field name="destination_journal_id" position="replace"/> -->
            <field name="amount_signed" position="replace" />
            <field name="amount_signed" position="replace" />
            <field name="amount_company_currency_signed" position="replace" />
        </field>
    </record>


    <!-- sobre condiciones de invisibilidad:
    en payment pro solemos usar invisible="is_internal_transfer or not use_payment_pro"
    en sipreco estamos viendo que por lo general los flujos avanzados tienen "transaction_id or
    advance_request_id" por lo cual estamos usando invisible="not transaction_id and not
    advance_request_id"
    eventualmente si es necesario se puede combinar ambos criterios
     -->
    <record id="view_account_payment_form_ex_pay_group" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">

            <field name="date" position="after">
                <field name="assignee_id" groups="!public_budget.group_change_payment_assignee"
                    readonly="state != 'draft'" />
                <field name="assignee_id" groups="public_budget.group_change_payment_assignee" />
                <field name="return_payment_id" invisible="not return_payment_id" />
            </field>
            <field name="date" position="attributes">
                <!-- <attribute name="invisible">1</attribute> -->
                <!-- al final lo hacemos invisible así porque en transferencias lo queremos visible -->
                <attribute name="readonly">state != 'draft'</attribute>
            </field>

            <!-- en sipreco, para el pago de retenciones no queremos pasar por todo el circuito de
            doble confirmación), ademas no queremos que usen talonario de ordenes de pago y es medio
            complicado generar otro talonario exclsuivo para esto y pasarlo por defecto, entonces
            hacemos que talonario y numero de docuemnto sean solo requeridos si es pago de
            transacción o de adelantos -->
            <field name="receiptbook_id" position="attributes">
                <attribute name="invisible">not transaction_id and not advance_request_id</attribute>
                <attribute name="required">transaction_id or advance_request_id</attribute>
            </field>

            <form>
                <field name="advance_request_id" invisible="1" />
                <!-- used on expedient domain -->
                <field name="user_location_ids" invisible="1" />
                <field name="transaction_with_advance_payment" invisible="1" />
                <field name="partner_ids" invisible="1" />
            </form>
            <form position="attributes">
                <attribute name="create">false</attribute>
            </form>

            <field name="state" position="attributes">
                <attribute name="name">sipreco_state</attribute>
            </field>
            <!-- movemos todo lo relativo a pago a una pestaña para que quede mas parecido a con pay
            group y menos recargado arriba -->
            <page name="paid" position="before">
                <page string="Pago" name="payment">
                </page>
            </page>
            <page name="payment" position="inside">
                <group name="group2" position="move" />
            </page>

            <!-- creamos nuevo grupo para todo lo de fechas asi queda como antes -->
            <group name="group1" position="after">
                <group name="group3">
                </group>
            </group>
            <group name="group3" position="inside">
                <field name="date" position="move" />
            </group>

            <field name="partner_id" position="attributes">
                <attribute name="domain">[('id', 'in', partner_ids)]</attribute>
                <attribute name="readonly">sipreco_state not in ('draft')</attribute>
            </field>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                 <attribute name="domain">[('id', 'in', partner_ids)]</attribute>
                <attribute name="readonly">sipreco_state not in ('draft')</attribute>
            </xpath>

            <!-- confirm only for account manager -->
            <button name="action_post" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </button>

            <!-- por ahora ocultamos para tener vista más limpia -->
            <field name="memo" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>

            <field name="memo" position="before">
                <field name="reference" />
            </field>

            <field name="date" position="before">
                <!-- is_internal_transfer or not use_payment_pro -->
                <field name="payment_base_date" readonly="sipreco_state != 'draft'"
                    required="transaction_id or advance_request_id"
                    invisible="not transaction_id and not advance_request_id" />
                <label for="payment_days" invisible="not transaction_id and not advance_request_id" />
                <div class="oe_inline" readonly="state != 'draft'"
                    invisible="not transaction_id and not advance_request_id">
                    <field name="payment_days" class="oe_inline" />
                    <field name="days_interval_type" class="oe_inline" />
                </div>
                <field name="payment_min_date"
                    invisible="not transaction_id and not advance_request_id" />
                <!-- lo hacemos editable con tec features -->
                <field name="confirmation_date" readonly="1"
                    invisible="not transaction_id and not advance_request_id" />
                <field name="to_signature_date" readonly="1"
                    invisible="not transaction_id and not advance_request_id" />
            </field>

            <field name="partner_id" position="after">
                <field name="transaction_id" invisible="not transaction_id" readonly="True"
                    force_save="True" />
                <field name="budget_id" invisible="not transaction_id" />
                <field name="expedient_id"
                    domain="[('type', '=','payment'), ('state', '=', 'open'), ('current_location_id', 'in', user_location_ids), ('in_transit', '=', False)]"
                    readonly="sipreco_state != 'draft'" invisible="not transaction_id"
                    required="transaction_id" />
                <field name="budget_position_ids" widget="many2many_tags"
                    invisible="not transaction_id" />
                <field name="public_invoice_ids" widget="many2many_tags"
                    invisible="not transaction_id" />
            </field>

            <!-- add payment order and print receipt button -->
            <button name="unmark_as_sent" position="after">
                <button name="%(action_aeroo_report_payment)d" string="Print Payment Order"
                    class="oe_highlight" groups="base.group_user" type="action"
                    invisible="not transaction_id and not advance_request_id" />
                <button name="%(action_aeroo_report_payment_receipt)d" class="oe_highlight"
                    string="Print Receipt" type="action"
                    invisible="not transaction_id and not advance_request_id" />
            </button>

            <button name="action_cancel" position="before">
                <button name="action_aeroo_certificado_de_retencion_report"
                    string="Print withholding voucher" type="object"
                    invisible="sipreco_state not in ['in_process', 'paid'] or (not transaction_id and not advance_request_id)" />
            </button>

            <!-- como ellos pagan con adelanto o conciliando, y no el mix, excondemos deuda
            seleccionada y importe de ajuste y solo mostramos el a pagar que lo hacemos editable o
            no segun sea de adelanto o no -->
            <!-- hide unreconciled_amount on not advance transactions  -->
            <field name="selected_debt" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="unmatched_amount" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="to_pay_amount" position="attributes">
                <!-- <attribute name="invisible">payment_subtype != 'double_validation' or state ==
                'posted'</attribute> -->
                <attribute name="readonly">not transaction_with_advance_payment or sipreco_state != 'draft'</attribute>
            </field>

            <!-- para algunos campos hacemos que se pueden editar solo en estado "confirmado" que es
            para que tesoreria prepare pago -->
            <!-- <field name="journal_id" position="attributes">
                <attribute name="readonly">state != 'confirmed'</attribute>
            </field>
            <field name="amount" position="attributes">
                <attribute name="readonly">state != 'confirmed'</attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="readonly">state != 'confirmed'</attribute>
            </field>
            <field name="payment_method_line_id" position="attributes">
                <attribute name="readonly">state != 'confirmed'</attribute>
            </field> -->
            <!-- de pay pro (por ahora no los pusimos ya que probablemente no los usen, si hace
            falta, además del de abajo se requiere write_off_amount y todo lo de Secondary Currency
            que por ahí no lo usan) -->
            <!-- <field name="amount_company_currency" position="attributes">
                <attribute name="readonly">state != 'confirmed'</attribute>
            </field> -->

            <!-- este post and new no lo queremos para nada -->
            <button name="action_post_and_new" position="attributes">
                <attribute name="invisible">True</attribute>
            </button>

            <!-- Post para pagos no vinculados a transacción / request -->
            <button name="action_post" position="attributes">
                <!-- <attribute name="invisible">payment_subtype == 'simple' and state != 'draft' or
                payment_subtype == 'double_validation' and state != 'signed'</attribute> -->
                <attribute name="invisible">state != 'draft' or transaction_id or advance_request_id</attribute>
                <!-- <attribute name="invisible">sipreco_state != 'signed'</attribute> -->
                <attribute name="groups">public_budget.group_habilitacion_usuario</attribute>
            </button>

            <!-- Add signe buttons -->
            <button name="action_post" position="after">
                <!-- post para el flujo con transacciń / request -->
                <button name="action_post" type="object" string="Validar" class="oe_highlight"
                    invisible="sipreco_state != 'signed'"
                    groups="public_budget.group_habilitacion_usuario" />
                <button name="confirm" type="object" string="Confirm" class="oe_highlight"
                    invisible="sipreco_state != 'draft' or (not transaction_id and not advance_request_id)"
                    groups="account.group_account_manager" />
                <button name="to_signature_process" class="oe_highlight"
                    string="To Signature Process" type="object"
                    groups="public_budget.group_habilitacion_usuario"
                    invisible="sipreco_state != 'confirmed'" />
                <button name="to_signed" type="object" class="oe_highlight" string="Signed"
                    groups="public_budget.group_habilitacion_director"
                    invisible="sipreco_state != 'signature_process'" />
                <button name="back_to_confirmed" type="object" string="Volver a Confirmado"
                    groups="public_budget.group_habilitacion_usuario"
                    invisible="sipreco_state not in ('signature_process', 'signed')" />
            </button>

            <!-- cancel button only to account user -->
            <button name="action_cancel" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </button>

            <!-- quieren que las retenciones se definan una vez confirmado el pago -->
            <!-- <field name="retencion_ganancias" position="attributes">
                <attribute name="required">company_regimenes_ganancias_ids and state == 'confirmed'</attribute>
            </field> -->

            <!-- ocultamos todo lo referente a moneda de contrapartida que no lo usan -->
            <label for="counterpart_currency_amount" position="replace" />
            <field name="counterpart_currency_amount" position="replace" />
            <div name="counterpart_currency_amount" position="replace" />
            <xpath expr="//div[@name='amount_div']//field[@name='currency_id']"
                position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <!-- latam_check_view_account_payment_form_inherited inherit form view -->
    <record id="latam_check_view_account_payment_form_inherited" model="ir.ui.view">
        <field name="name">latam_check_view_account_payment_form_inherited.inherit.view.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id"
            ref="account_payment_pro.latam_check_view_account_payment_form_inherited" />
        <field name="arch" type="xml">
            <button name="action_add_all" position="attributes">
                <attribute name="invisible">sipreco_state != 'draft'</attribute>
            </button>
            <button name="remove_all" position="attributes">
                <attribute name="invisible">sipreco_state != 'draft'</attribute>
            </button>
            <xpath expr="//page[@name='debts']//button[3]" position="attributes">
                <attribute name="invisible">sipreco_state != 'draft'</attribute>
            </xpath>
            <xpath expr="//page[@name='debts']//button[4]" position="attributes">
                <attribute name="invisible">sipreco_state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='to_pay_move_line_ids']" position="attributes">
                <attribute name="readonly">sipreco_state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='to_pay_move_line_ids']" position="attributes">
                <attribute name="context">{'list_view_ref': 'public_budget.view_move_line_tree'}</attribute>
            </xpath>

        </field>
    </record>

