<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_account_payment_search">
        <field name="name">account.payment.filter</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <filter name='state_draft' position="after">
                <filter string="En Proceso de Firma" domain="[('state','=','signature_process')]" name='state_signature_process'/>
                <filter string="Firmado" domain="[('state','=','signed')]" name='state_signed'/>
            </filter>
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', '|', ('reference','ilike',self), ('name', 'ilike', self), ('partner_id', 'ilike', self), ('memo', 'ilike', self), ('amount_company_currency_signed' , 'ilike', self), ('amount', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field name="transaction_id"/>
                <field name="budget_id"/>
                <field name="expedient_id"/>
                <field name="budget_position_ids"/>
            </field>
            <filter name="state" position="after">
                <filter name="fecha_pago" string="Fecha Min. de Pago" domain="[]" context="{'group_by': 'payment_min_date'}"/>
            </filter>
        </field>
    </record>

    <!-- list view modification -->
    <record id="view_account_supplier_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.pay.list</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- para que solo se puedan crear con el botón -->
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
            <field name="date" position="after">
                <field name="payment_min_date"/>
            </field>
            <field name="payment_method_line_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="date" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <!-- para poder ver lo que se manda a pagar antes de que se carguen los pagos -->
            <field name="payment_total" position="before">
                <field name="to_pay_amount" sum="Total"/>
            </field>
            <field name="partner_id" position="before">
                <field name="reference"/>
                <field name="memo" optional="hide"/>
            </field>
            <list position="inside">
                <button name="confirm" type="object" string="Confirm" invisible="state != 'draft'" icon="fa-arrow-circle-right" groups="account.group_account_manager"/>
            </list>
        </field>
    </record>

    <!-- account.payment inherit form view -->
    <record id="account_payment_recieptbook_sipreco" model="ir.ui.view">
        <field name="name">account.payment.inherit.view.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_payment_pro_receiptbook.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- en sipreco, para el pago de retenciones no queremos pasar por todo el circuito de doble confirmación), ademas no queremos que usen talonario de ordenes de pago y es medio complicado generar otro talonario exclsuivo para esto y pasarlo por defecto, entonces hacemos que talonario y numero de docuemnto sean solo requeridos si es pago de transacción o de adelantos -->
            <field name="receiptbook_id" position="attributes">
                <attribute name="invisible">not transaction_id and not advance_request_id</attribute>
                <attribute name="required">transaction_id or advance_request_id</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="account_payment_pro.view_account_payment_form"/>
        <field name="arch" type="xml">



            <!-- <button name="action_payment_sent" position="attributes">
                <attribute name="invisible">state not in ['posted', 'signed']</attribute>
            </button> -->

            <!-- agregamos este campo por compatibilidad con mig desde v8 y además para simplificar liquidación -->
            <!-- <field name="payment_ids" position="after">
                <label for="withholding_line_ids" string="Detalle de Retenciones" invisible="state != 'posted'"/>
                <field name="withholding_line_ids" context="{'list_view_ref':'account_tax_settlement.view_account_move_line_tree', 'default_type': 'entry'}" invisible="state != 'posted'"/>
            </field> -->

            <form>
                <field name="advance_request_id" invisible="1"/>
                <!-- used on expedient domain -->
                <field name="user_location_ids" invisible="1"/>
                <field name="transaction_with_advance_payment" invisible="1"/>
                <field name="partner_ids" invisible="1"/>
            </form>

            <form position="attributes">
                <attribute name="create">false</attribute>
            </form>

            <field name="partner_id" position="attributes">
                <attribute name="domain">[('id', 'in', partner_ids)]</attribute>
            </field>

            <!-- confirm only for account manager -->
            <button name="action_post" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </button>

            <field name="memo" position="before">
                <field name="reference"/>
            </field>

            <field name="date" position="before">
                <field name="payment_base_date" readonly="state != 'draft'" required="transaction_id or advance_request_id"/>
                <label for="payment_days"/>
                <div class="oe_inline" readonly="state != 'draft'">
                    <field name="payment_days" class="oe_inline"/>
                    <field name="days_interval_type" class="oe_inline"/>
                </div>
                <field name="payment_min_date"/>
                <!-- lo hacemos editable con tec features -->
                <field name="confirmation_date" readonly="1"/>
                <field name="to_signature_date" readonly="1"/>
            </field>

            <field name="partner_id" position="after">
                <field name="transaction_id" invisible="not transaction_id"/>
                <field name="budget_id" invisible="not transaction_id"/>
                <field name="expedient_id" domain="[('type', '=','payment'), ('state', '=', 'open'), ('current_location_id', 'in', user_location_ids), ('in_transit', '=', False)]" readonly="state != 'draft'" invisible="not transaction_id" required="transaction_id"/>
                <field name="budget_position_ids" widget="many2many_tags"/>
                <field name="invoice_ids" widget="many2many_tags"/>
            </field>

            <!-- add payment order and print receipt button -->
            <button name="unmark_as_sent" position="after">
                <button name="%(action_aeroo_report_payment)d" string="Print Payment Order" class="oe_highlight" groups="base.group_user" type="action" />
                <button name="%(action_aeroo_report_payment_receipt)d" class="oe_highlight" string="Print Receipt" type="action"/>
            </button>

            <button name="action_cancel" position="before">
                <button name="action_aeroo_certificado_de_retencion_report" string="Print withholding voucher" type="object" class="oe_read_only"/>
            </button>

            <!-- como ellos pagan con adelanto o conciliando, y no el mix, excondemos deuda seleccionada y importe de ajuste y solo mostramos el a pagar que lo hacemos editable o no segun sea de adelanto o no -->
            <!-- hide unreconciled_amount on not advance transactions  -->
            <field name="selected_debt" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="unmatched_amount" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- <field name="to_pay_amount" position="attributes">
                <attribute name="invisible">payment_subtype != 'double_validation' or state == 'posted'</attribute>
                <attribute name="readonly">not transaction_with_advance_payment or state != 'draft'</attribute>
            </field> -->


            <!-- Make post only visible from signed and available for hab director -->
            <button name="action_post" position="attributes">
                <!-- <attribute name="invisible">payment_subtype == 'simple' and state != 'draft' or payment_subtype == 'double_validation' and state != 'signed'</attribute> -->
                <attribute name="invisible">state != 'draft' or state != 'signed'</attribute>
                <attribute name="groups">public_budget.group_habilitacion_usuario</attribute>
            </button>

            <!-- Add signe buttons -->
            <button name="action_post" position="after">
                <button name="to_signature_process" class="oe_highlight" string="To Signature Process" type="object" groups="public_budget.group_habilitacion_usuario" invisible="state != 'confirmed'"/>
                <button name="to_signed" type="object" class="oe_highlight" string="Signed" groups="public_budget.group_habilitacion_director" invisible="state != 'signature_process'"/>
                <button name="back_to_confirmed" type="object" string="Volver a Confirmado" groups="public_budget.group_habilitacion_usuario" invisible="state not in ('signature_process', 'signed')"/>
            </button>

            <!-- cancel button only to account user -->
            <button name="action_cancel" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </button>

            <!-- quieren que las retenciones se definan una vez confirmado el pago -->
            <!-- <field name="retencion_ganancias" position="attributes">
                <attribute name="required">company_regimenes_ganancias_ids and state == 'confirmed'</attribute>
            </field> -->
        </field>
    </record>

