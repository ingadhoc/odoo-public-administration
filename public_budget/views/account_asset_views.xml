<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_account_asset_search" model="ir.ui.view">
        <field name="name">account.asset.search</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="expedient_id"/>
                <field name="invoice_id" readonly="state != 'draft'"/>
                <field name="reference"/>
                <field name="enrollment"/>
                <field name="serial_number"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </field>
            <group>
                <filter string="Invoice" name="invoice" domain="[]" context="{'group_by':'invoice_id'}"/>
            </group>
        </field>
    </record>

    <record id="view_account_asset_asset_purchase_tree" model="ir.ui.view">
        <field name="name">account.asset.list</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="reference"/>
            </field>
        </field>
    </record>

    <!-- FORMVIEW -->
    <record id="view_account_asset_asset_form" model="ir.ui.view">
        <field name="name">account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <!-- <notebook position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </notebook> -->
            <div name="button_box">
                <field name="transaction_ids" invisible="1"/>
                <button type="object" name="action_view_transaction" class="oe_stat_button" string="Transactions" icon="fa-list-alt" invisible="state == 'model' or not transaction_ids"/>
            </div>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>               <group invisible="state == 'model'">
                        <field name="model_id" help="Category of asset" options="{'horizontal': true}" domain="[('state', '=', 'model'), ('account_type', '=?', account_type), ]"/> <!-- ('asset_type', '=', asset_type) Saco de dom no existe mas el campo, no tiene simil en 18-->
                        <field name="enrollment"/>
                        <field name="reference"/>
                        <field name="serial_number"/>
                        <field name="asset_state" required="state != 'model'"/>
                        <field name="observations"/>
                        <field name="level"/>
                        <field name="number"/>
                        <field name="building"/>
                        <field name="location_id" readonly="location_id and state in ['open', 'paid']" required="state != 'model'" force_save="1" options="{'no_create': True}"/>
                        <field name="expedient_id" required="state != 'model'" options="{'no_create': True}"/>
                        <field name="user_id"/>
                        <field name="transit"/>
                    </group>
                    <group string="Extra Options" invisible="state == 'model'">
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="original_value" invisible="state == 'model'" readonly="state != 'draft' or original_move_line_ids"/>
                        <field name="acquisition_date" invisible="state == 'model'" readonly="state != 'draft' or original_move_line_ids"/>
                        <field name="partner_id" context="{'res_partner_search_mode': 'supplier'}" readonly="state != 'draft'"/>
                        <field name="invoice_id" domain="[('partner_id', '=', partner_id)]" readonly="state != 'draft'" options="{'no_create': True}"/>
                        <field name="comodato" invisible="state == 'model'"/>
                        <field name="patrimonial" invisible="state == 'model'"/>
                        <field name="reportable" invisible="state == 'model'"/>
                    </group>
                </group>
            </xpath>
            <button name="compute_depreciation_board" position="attributes">
                <attribute name="states"></attribute>
                <attribute name="groups">base.group_no_one</attribute>
            </button>
            <button name="set_to_draft" position="attributes">
                <attribute name="groups">public_budget.group_asset_responsable_ubicacion</attribute>
            </button>
            <button name="action_asset_modify" position="attributes">
                <attribute name="groups">public_budget.group_asset_responsable_ubicacion</attribute>
            </button>
            <button name="action_save_model" position="attributes">
                <attribute name="groups">public_budget.group_asset_responsable_ubicacion</attribute>
            </button>
            <!-- <button name="action_asset_modify" position="attributes">  ahora para pauassar o hacer cualquier modiicaicon tenemos un solo widget
                <attribute name="groups">base.group_no_one</attribute>      Modificamos oara que se limite la visuliacion en el widget
            </button> -->
            <!-- <button name="action_set_to_close" position="replace"> esto tambien esta desde asset_modify
                <button name="archive_and_close_asset" type="object" invisible="not active or state != 'open'" string="Close and Archive" groups="public_budget.group_asset_responsable_ubicacion"/>
            </button>  -->
            <!-- <notebook position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </notebook>
            <button name="open_entries" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </button>
            <xpath expr="//field[@name='method']//.." position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//field[@name='salvage_value']//.." position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath> -->
            <button name="compute_depreciation_board" position="after">
                <field name="visible_button_transfer_asset" invisible="1"/>
                <button name="transfer_asset" type="object" invisible="not visible_button_transfer_asset or transit or state == 'model'" string="Transfer Asset" />
                <button name="confirm_tranfer" type="object" invisible="not visible_button_transfer_asset or not transit or state == 'model'" string="Confirm Transfer Asset"/>
            </button>
            <xpath expr="//field[@name='journal_id']//.." position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <xpath expr="//group/group//field[@name='gross_increase_value']//.." position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>

            <!-- TODO Los xpaths se esan comportndo de manera extraña revisar -->
            <!-- <xpath expr="//page[@name='main_page']/group/group[4]/field[@name='company_id']"  position="replace"/>
            <xpath expr="//page[@name='main_page']/group/group[1]/field[@name='original_value']" position="replace"/>
            <xpath expr="//page[@name='main_page']/group/group[1]/field[@name='acquisition_date']"  position="replace"/> -->
        </field>
    </record>


    <record id="view_account_asset_asset_purchase_tree_portal" model="ir.ui.view">
        <field name="name">account.asset.list.portal</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
        <!-- <field name="groups_id" eval="[(4, ref('base.group_portal'))]"/> -->
        <field name="arch" type="xml">
            <field name="activity_exception_decoration" position="replace"/>
        </field>
    </record>

    <menuitem name="Asset" id="menu_asset" groups="group_asset_usuario,public_budget.group_portal_asset" web_icon="public_budget,static/description/asset-icon.png" sequence="40"/>

    <menuitem id="menu_account_asset" name="Assets" parent="menu_asset" sequence="2" action="account_asset.action_account_asset_form"/>
    <menuitem parent="menu_asset" id="menu_account_asset_model" action="account_asset.action_account_asset_model_form" groups="group_asset_usuario,public_budget.group_portal_asset"/>

</odoo>
