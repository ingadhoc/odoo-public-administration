<odoo>
    <record id="account_fiscal_position" model="ir.ui.view">
        <field name="name">account.fiscal.position.inherit.view.form</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']/.." position="inside">
                <field name="dont_recompute_withholdings" class="o_field_boolean"/>
            </xpath>
        </field>
    </record>
</odoo>
