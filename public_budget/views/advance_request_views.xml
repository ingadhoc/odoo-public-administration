<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_public_budget_advance_request_filter" model="ir.ui.view">
        <field name="name">public_budget.advance_request.select</field>
        <field name="model">public_budget.advance_request</field>
        <field name="arch" type="xml">
            <search string="advance_request">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="type_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_type_id" string="Type" context="{'group_by':'type_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORMVIEW -->
    <record id="view_public_budget_advance_request_form" model="ir.ui.view">
        <field name="name">public_budget.advance_request.form</field>
        <field name="model">public_budget.advance_request</field>
        <field name="arch" type="xml">
            <form string="advance_request">
                <header>
                    <button name="action_approve" invisible="state != 'draft'" string="Approve" type="object" class="oe_highlight" groups="public_budget.group_secretary_director"/>
                    <button name="action_confirm" invisible="state != 'approved'" string="Confirm" type="object" class="oe_highlight" groups="account.group_account_user"/>
                    <button name="action_cancel_draft" type="object" invisible="state != 'cancel'" string="To Draft"/>
                    <button name="action_cancel" invisible="state != 'confirmed'" string="Cancel" type="object" groups="account.group_account_user"/>
                    <button name="action_cancel" invisible="state not in ('approved', 'draft')" string="Cancel" type="object" groups="public_budget.group_secretary_director,account.group_account_user"/>
                    <field name="state" widget="statusbar" statusbar_colors='{}'/>
                </header>
                <sheet string="advance_request">
                    <div class="oe_button_box" name="buttons">
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="approval_date" invisible="not approval_date" readonly="state != 'draft'"/>
                            <field name="approval_user" invisible="not approval_user"/>
                            <field name="confirmation_date" invisible="not confirmation_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="advance_request_line_ids" readonly="state != 'draft'">
                                <list editable="top">
                                    <field name="employee_id"/>
                                    <field name="description"/>
                                    <field name="debt_amount" invisible="state != 'draft'" sum="Total"/>
                                    <field name="pending_return_amount" invisible="state != 'draft'" sum="Total"/>
                                    <field name="requested_amount" sum="Total"/>
                                    <field name="approved_amount" sum="Total"/>
                                    <field name="state" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment Orders">
                            <field name="payment_ids" context="{'default_partner_type': 'supplier'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREEVIEW -->
    <record id="view_public_budget_advance_request_tree" model="ir.ui.view">
        <field name="name">public_budget.advance_request.list</field>
        <field name="model">public_budget.advance_request</field>
        <field name="arch" type="xml">
            <list string="advance_request" decoration-muted="state=='cancelled'" decoration-info="state == 'draft'" decoration-bf="state in ['approved', 'confirmed']" decoration-danger="state in ()">
                <field name="name" readonly="state != 'draft'"/>
                <field name="type_id" readonly="state != 'draft'"/>
                <field name="date" readonly="state != 'draft'"/>
                <field name="user_id" readonly="state != 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                <field name="state"/>
            </list>
        </field>
    </record>

</odoo>
