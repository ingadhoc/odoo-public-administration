    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <field name="list_price" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </field>

            <field name="invoice_policy" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </field>

            <!-- ocultamos opciones de ser vendido/comprado -->
            <div name="options" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </div>

        </field>
    </record>

    <!-- prodcut.template inherit form view -->
    <record id="product_template_view_form_recurring" model="ir.ui.view">
        <field name="name">product.template.inherit.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_subscription.product_template_view_form_recurring"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='subscription_pricing']" position="attributes">
                <attribute name="groups">sales_team.group_sale_salesman</attribute>
            </xpath>

        </field>
    </record>

</odoo>
